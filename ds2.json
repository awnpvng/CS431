        },
        {
            "source_schema": "public", "source_table": "customers", "source_column": "customerid",
            "target_schema": "public","target_table": "orders","target_column": "customerid",
            "relations_type": "one to many"
        },
        {
            "source_schema": "public","source_table": "orders","source_column": "orderid",
            "target_schema": "public","target_table": "orderlines","target_column": "orderid",
            "relations_type": "one to many"
        },
        {
            "source_schema": "public","source_table": "products", "source_column": "prod_id",
            "target_schema": "public","target_table": "orderlines","target_column": "prod_id",
            "relations_type": "one to many"
        },
        {
            "source_schema": "public","source_table": "products","source_column": "prod_id",
            "target_schema": "public","target_table": "inventory","target_column": "prod_id",
            "relations_type": "one to one"
        },
        {
            "source_schema": "public", "source_table": "categories", "source_column": "castegory",
            "target_schema": "public","target_table": "products","target_column": "castegory",
            "relations_type": "one to many"
        }
    ]
}